# PyInstaller output — regenerated by build.py, which also writes the generated
# .icns into build/ on macOS
build/
dist/
*.spec

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Optional vendored binaries (see deps.py — normally fetched on first run)
vendor/

# Source artwork (PSD + full-size exports). The built assets/*.ico is committed;
# these stay local so the repo doesn't carry tens of MB of binary that git can't
# diff.
grafika/

# Working notes between sessions — process, not product. The README is what
# users read; this stays local.
HANDOFF.md

# Editors / OS
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store

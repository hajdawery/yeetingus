{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YEETingus",
  "version": "2.0.0",
  "identifier": "com.haej.yeetingus",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "YEETingus",
        "width": 1000,
        "height": 720,
        "minWidth": 720,
        "minHeight": 520,
        "theme": "Dark",
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https://*.ytimg.com https://*.googleusercontent.com data:; style-src 'self' 'unsafe-inline'; connect-src 'self' http://127.0.0.1:* ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/yeetingus-service"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "yeetingus"
        ]
      }
    }
  }
}